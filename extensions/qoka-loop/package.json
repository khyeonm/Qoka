{
	"name": "qoka-loop",
	"displayName": "Qoka Research Loop Engine",
	"description": "Research Loop Engine MCP: the deterministic controller that designs a research loop, runs it as a background loop of headless sub-agents, and judges each iteration with a locked evaluator. Built into Qoka.",
	"version": "0.0.1",
	"publisher": "aria",
	"license": "MIT",
	"engines": {
		"vscode": "^1.123.0"
	},
	"main": "./out/extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"commands": [
			{
				"command": "qoka.loop.open",
				"title": "Qoka: Open Loops",
				"category": "Qoka"
			}
		]
	},
	"scripts": {
		"compile": "node build.mjs",
		"watch": "node build.mjs --watch",
		"typecheck": "tsc -p ./ --noEmit"
	},
	"devDependencies": {
		"@types/node": "^20",
		"esbuild": "^0.24.2",
		"typescript": "^5.6.2"
	}
}
